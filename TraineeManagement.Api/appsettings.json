{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "your-ConnectionStrings",
    "Redis":"Redis-url",
    "CacheMinutes":10
  },
  "RabbitMQ":{
     "Host":"your-RabbitMQ-url",
     "Post":5672,
     "Username":"username",
     "Password":"Password",
     "VirtualHost": "/"
  },
  "Jwt": {
    "Issuer": "Issuer",
    "Audience": "Audience",
    "Key":"your-key",
    "ExpiryMinutes": 60
  },
  "SeedData": {
    "AdminUsername": "name",
    "AdminEmail": "email",
    "AdminPassword": "Password"
  },
  "FileStorage": {
    "UploadPath" : "UploadPath",
    "MaxSizeMB" : 10,
    "AllowedExtensions" : [".pdf" , ".jpg" , ".png" , ".txt" , ".docx"]
  }


}